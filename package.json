{
  "name": "@opencampus/ochub-utils",
  "version": "0.1.0",
  "description": "Open Campus Hub utilities library for analytics and account management",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./analytics": {
      "import": "./dist/analytics/index.js",
      "require": "./dist/analytics/index.js",
      "types": "./dist/analytics/index.d.ts"
    },
    "./account": {
      "import": "./dist/account/index.js",
      "require": "./dist/account/index.js",
      "types": "./dist/account/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencampus",
    "analytics",
    "account",
    "utilities"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@opencampus/ocid-connect-js": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "typescript": "^5.3.3"
  }
}
